<configuration>
  <appSettings>
    <clear />
    <add key="SESSION_SECRET_KEY" value="REDACTED"/>
    <add key="NODE_ENV" value="production"/>

  </appSettings>
  <system.webServer>
    <handlers>
      <add name="test-handler" path="test.js" verb="*" modules="iisnode" />
      <add name="clinical-trial-matching-app-iisnode" path="server.js" verb="*" modules="iisnode" />
    </handlers>
    <rewrite>
      <rules>
        <clear />
        <rule name="test-bypass" stopProcessing="true">
          <match url="^test\.js$" />
          <action type="None" />
        </rule>
        <rule name="clinical-trial-matching-app-rewrite">
          <match url="/*" />
          <action type="Rewrite" url="server.js" />
        </rule>
      </rules>
    </rewrite>
    <security>
      <requestFiltering>
        <requestLimits maxQueryString="1024000" maxUrl="2048000"/>
      </requestFiltering>
    </security>
    <iisnode devErrorsEnabled="false" />
  </system.webServer>
</configuration>
